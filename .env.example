# Public HTTPS URL used by the in-app Privacy Policy link in store builds.
# The same URL must be configured in Google Play Console.
VITE_PRIVACY_POLICY_URL=https://xavierrlx.github.io/Galerows/privacy.html

# Landing page: leave empty until official store listings are live.
# Setting a valid HTTPS store URL enables its download buttons automatically.
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=

# Local development only: VITE_APP_PREVIEW=1 npm run dev opens the game app.
# Native Capacitor builds always open the game app, independently of this flag.
VITE_APP_PREVIEW=0
